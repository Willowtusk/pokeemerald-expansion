script Professor_ChooseYourStarter_MOVE_ONE{
    lockall
    msgbox("{PLAYER}!")
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, MOVE_UP_ONE)
    waitmovement(0)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_SOUTH)
    faceplayer
    msgbox(format(
        "There you are!\n"
        "I've been trying to get ahold of you all day.\p"
        "Have you ever thought about traveling the region?\p"
        "Me and mom think it would be good for you\nto see the world.\p"
        "But, you can't travel the world without a companion can you?\p"
        "I think it's finally time for you to get a Pokemon {PLAYER}.\p"
        "My field research has allowed me to spare some Pokemon for your journey!\p"
        "Why don't you pick one?"
        ))
    waitmessage
    setvar(VAR_TALK_TO_MOM_1, 2)
    releaseall
    end

}

script Professor_ChooseYourStarter_MOVE_TWO{
    lockall
    msgbox("{PLAYER}!")
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, MOVE_UP_AND_LEFT)
    waitmovement(0)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_SOUTH)
    faceplayer
    msgbox(format(
        "There you are!\n"
        "I've been trying to get ahold of you all day.\p"
        "Have you ever thought about traveling the region?\p"
        "Me and mom think it would be good for you to go out and see the world.\p"
        "But, you can't travel the world without a companion can you?\p"
        "I think it's finally time for you to get a Pokemon {PLAYER}.\p"
        "My field research has allowed me to spare some Pokemon for your journey!\p"
        "Why don't you pick one?"
        ))
    waitmessage
    setvar(VAR_TALK_TO_MOM_1, 2)
    releaseall
    end

}



movement MOVE_UP_ONE{
    walk_up
}

movement MOVE_UP_AND_LEFT{
    walk_up
    walk_left
}

script DAD_LAB_CONVO_1{
    lockall
    faceplayer
    if (var(VAR_TALK_TO_MOM_1) <= 5){
        msgbox(format(
        "You should go see our new neighbor that just moved in last week.\p"
        "She seems nice, I think her name is Leah."
    ))
    closemessage
    releaseall
    }
    else {
        msgbox(format(
            "Why don't you head out to\nDustrowe Town?\p"
            "It's just down the road here."
        ))
        closemessage
        releaseall
    }
}

script Choose_Starter{
    lockall
    msgbox("I should choose a Pokemon first.")
    applymovement(OBJ_EVENT_ID_PLAYER, SIMPLE_MOVE_UP_ONE)
    waitmovement(0)
    closemessage
    releaseall
}

script Starter_Obtained_Pokedex_Get{
    lockall
    turnobject(1, DIR_NORTH)
    msgbox(format(
        "So you chose that one?\p"
        "In that case, you'll be needing this!\p"
        "{PLAYER} Received the POKéDEX!"
        ))
    playfanfare(MUS_OBTAIN_ITEM)
    waitmessage
    waitfanfare
    setflag(FLAG_SYS_POKEDEX_GET)
    special(SetUnlockedPokedexFlags)
    closemessage
    return
}

movement SIMPLE_MOVE_UP_ONE{
    walk_up
}