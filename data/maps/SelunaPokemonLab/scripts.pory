mapscripts SelunaPokemonLab_MapScripts{

}

script ChoosingAStarter_Piplup{
    lockall
    if(!(flag(FLAG_FENNEKIN_STARTER) || flag(FLAG_CHIKORITA_STARTER) || flag(FLAG_PIPLUP_STARTER))){
        showmonpic(SPECIES_PIPLUP, 10,3)
        playmoncry(SPECIES_PIPLUP, CRY_MODE_ENCOUNTER)
        waitmoncry
        msgbox("Would you like to choose\nthe Water Type Piplup?", MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            givemon (SPECIES_PIPLUP, 5)
            if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
                clearflag(FLAG_LEAH_HOUSE_INTERACTION)
                setvar(VAR_TALK_TO_MOM_1, 3)
                playfanfare(MUS_OBTAIN_ITEM)
                msgbox("Received Piplup!")
                removeobject(2)
                setflag(FLAG_PIPLUP_STARTER)
                setflag(FLAG_SYS_POKEMON_GET)
                call(NicknamePartyMon)
                goto(Starter_Obtained_Pokedex_Get)
            }
            elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
                playfanfare(MUS_OBTAIN_ITEM)
                msgbox("Received Piplup!")
                removeobject(2)
                setvar(VAR_TALK_TO_MOM_1, 3)
                setflag(FLAG_PIPLUP_STARTER)
                call(NicknameBoxMon)
                goto(Starter_Obtained_Pokedex_Get)
            }
            else{
                hidemonpic
                msgbox("No More Room")
            }
        }
        else{
            hidemonpic
            msgbox(Starter_NotChosen)
        }
    
    }    
    else{
        msgbox("(I shouldn't take another)")
    }
    
waitmessage
releaseall
end
}

script NicknamePartyMon{
    msgbox("Would you like to give it a nickname?", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
}


script NicknameBoxMon{
    msgbox("Would you like to give it a nickname"?, MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_NameReceivedBoxMon)
    }
    msgbox("Transferred to PC")

}

text Starter_NotChosen{
    "You did not choose a Pokemon"

}




