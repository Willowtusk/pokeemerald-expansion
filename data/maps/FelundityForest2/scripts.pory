mapscripts FelundityForest2_MapScripts{

}

script Felundity_Forest_Boy1{

    lockall
    faceplayer
    msgbox("You notice how much this looks\n"
    "like a cat's paw?\p"
    )
    closemessage
    releaseall
}

script Felundity_Forest_Girl1{

    lockall
    faceplayer
    msgbox("I love cats!")
    closemessage
    releaseall
}

script Felundity_Forest_Girl2{

    lockall
    faceplayer
    if (flag(FLAG_CAT_LADY_NEST_BALL) == FALSE){
        msgbox("Do you like Pokémon that look\n"
        "like cats?\p"
        "Here take these!")
        giveitem(ITEM_NEST_BALL, 10)
        setflag(FLAG_CAT_LADY_NEST_BALL)
    }
   else{
    msgbox("Now go catch some felines!")
   }
  
    closemessage
    releaseall
}


script FelundityForestL{
    lockall
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(48)
    playse(SE_LEDGE)
    applymovement(8, HopUpInPlace)
    waitmovement(0)
    delay(48)
    msgbox(format("Hey!"))
    waitmessage
    playse(SE_LEDGE)
    applymovement(8, HopUpInPlace)
    waitmovement(0)
    delay(48)
    msgbox(format("Don't you dare mess with my sweet skitty! Just who even are you?"))
    waitmessage
    playse(SE_LEDGE)
    applymovement(6, HopDownInPlace)
    waitmovement(0)
    delay(48)
    msgbox(format("Miss, we need your Pokémon to conduct some quick tests. It will only take a minute and then you'll have your precious skitty back I promise."))
    waitmessage
    msgbox(format("Why you....."))
    waitmessage
    delay(48)
    applymovement(8, FaceDown)
    waitmovement(0)
    delay(48)
    playse(SE_LEDGE)
    applymovement(8, HopDownInPlace)
    waitmovement(0)
    delay(48)
    msgbox(format("Oh! A trainer!"))
    waitmessage
    closemessage
    applymovement(8, MediumMoveDown)
    waitmovement(0)
    delay(48)
    msgbox(format("Please, help me save my skitty! I would fight back but I've become so weak as of late and haven't had time to rest. Won't you help?"))
    waitmessage
    applymovement(8, Up2_Left1)
    applymovement(OBJ_EVENT_ID_PLAYER, Up3)
    waitmovement(8)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(6, FaceRight)
    waitmovement(0)
    delay(24)
    msgbox(format("Take this thing back to the lab Sally, and quick!"))
    waitmessage
    closemessage
    delay(24)
    applymovement(9, Escape)
    applymovement(7, Escape)
    waitmovement(9)
    waitmovement(7)
    fadescreen(FADE_TO_BLACK)
    removeobject(9)
    removeobject(7)
    delay(48)
    fadescreen(FADE_FROM_BLACK)
    applymovement(6, FaceDown)
    waitmovement(0)
    applymovement(6, WalkInPlaceDown)
    waitmovement(0)
    msgbox(format("Alright kid, you think you can take me and save your friend's pet huh? No one gets in the way of Team Helix!"))
    trainerbattle_no_intro(TRAINER_HELIX_GRUNT_MAX, TEAM_HELIX_GRUNT_MAX_OUTRO,)
    goto(HELIX_LEAVES_FELUNDITY_FOREST)


}

