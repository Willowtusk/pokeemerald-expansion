    goto(HELIX_LEAVES_FELUNDITY_FOREST)

}

movement Hop_twice{
    jump_in_place_up *2
}

movement DoubleExclamation{
    emote_double_exclamation_mark
}

movement Up2_Left1{

    walk_up * 2
    walk_left
    face_player
}

movement Up3{
    walk_up * 3
}

movement Escape{
    walk_up * 5
    walk_left * 3
    walk_up * 3
}


text TEAM_HELIX_GRUNT_MAX_OUTRO{
    "Oooo, you've got some moves!"
}

script HELIX_LEAVES_FELUNDITY_FOREST{
    lockall
    msgbox(format("Hehe, you got me kid. Time to report back to base!"))
    waitmessage
    closemessage
    applymovement(6, Escape)
    waitmovement(6)
    fadescreen(FADE_TO_BLACK)
    removeobject(6)
    delay(48)
    fadescreen(FADE_FROM_BLACK)
    applymovement(8, SIMPLE_MOVE_UP)
    waitmovement(0)
    msgbox("Get back here!!")
    waitmessage
    closemessage
    applymovement(8, Escape)
    waitmovement(8)
    fadescreen(FADE_TO_BLACK)
    removeobject(8)
    delay(48)
    fadescreen(FADE_FROM_BLACK)
    setvar(VAR_FELUNDITY_FOREST, 1)
    setflag(FLAG_FELUNDITY_SCENARIO)
    releaseall
    
}

movement FaceDown{
    face_down
}

movement FaceRight{
    face_right
}

movement WalkInPlaceDown{
    walk_in_place_down
}

movement MediumMoveDown{
    walk_down * 2
}

movement Right1Down2{
    walk_right
    walk_down * 2
}

movement Up2Left2{
    walk_up * 2
    walk_left * 2
    face_player
}

movement Up3Left1FaceUp{
    walk_up * 3
    walk_left
    face_up
}

movement HopDownInPlace{
    jump_in_place_down
}

movement HopUpInPlace{
    jump_in_place_up
}