script BankMan1{
    lockall
    faceplayer
    msgbox(format("What do you want??"))
    waitmessage
    releaseall
}

script BankMan2{
    lockall
    faceplayer
    msgbox(format("Can't you see I'm busy here?"))
    waitmessage
    releaseall
}

script BankMan3{
    lockall
    faceplayer
    msgbox(format("If I don't take out a loan right now, I'm done for...."))
    waitmessage
    releaseall
}

